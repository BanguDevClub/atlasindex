---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import { QuickCalculator } from "../components/landing/QuickCalculator";
import HighlightsGrid from "../components/landing/HighlightsGrid.astro";
import { GlobalOverviewPreview } from "../components/landing/GlobalOverviewPreview";
import { Button } from "../components/ui/button";
import { ArrowRight, BookOpen, Compass, Trophy } from "lucide-react";
import { getBasePath } from "../lib/utils";
---

<Layout
  title="AtlasIndex — Global Economy, Median Wage & Food Purchasing Power"
  description="Compare global economies by real purchasing power. Measure how many hours and minutes of labor a median wage earner needs to afford essential food baskets across 26 countries."
  keywords="food purchasing power, purchasing power parity, median wage, global economy, cost of living index, nutrition index, real wage comparison, labor effort index, Big Mac index alternative, AtlasIndex, BanguDevClub"
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Interactive Live Calculator & Visual Spectrum -->
  <section class="py-8">
    <div class="container mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7">
          <QuickCalculator client:load />
        </div>
        <div class="lg:col-span-5 flex flex-col gap-6">
          <GlobalOverviewPreview client:load />

          <div class="rounded-xl border border-border/80 bg-card/60 p-5 backdrop-blur flex flex-col gap-3">
            <h3 class="text-sm font-bold text-foreground">Why Median Wage Instead of GDP?</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Gross Domestic Product (GDP) per capita divides entire economic output across population, inflating figures with corporate profits, financial wealth, and ultra-high earners. Median wage reflects what a typical working person actually takes home.
            </p>
            <div class="pt-1">
              <a href={getBasePath("/methodology")}>
                <Button variant="link" size="sm" className="p-0 text-xs text-primary gap-1">
                  <span>Read our full methodology and peer review notes</span>
                  <ArrowRight class="size-3.5" />
                </Button>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Granular Highlights -->
  <HighlightsGrid />

  <!-- Explore CTA Grid -->
  <section class="py-16 border-t border-border/40 bg-muted/10">
    <div class="container mx-auto px-4 sm:px-8">
      <div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-4 mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
          Explore the Full AtlasIndex Platform
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground max-w-xl">
          Dive into data visualizations, export clean research tables, or compare up to 4 countries simultaneously.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href={getBasePath("/dashboard")} class="group rounded-2xl border border-border/80 bg-card/70 p-6 backdrop-blur hover:border-primary transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="size-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4 group-hover:scale-110 transition-transform">
              <Compass class="size-5" />
            </div>
            <h3 class="font-bold text-base text-foreground mb-1 group-hover:text-primary transition-colors">Global Dashboard</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Interactive charts, continental breakdowns, wage-to-basket scatter plots, and category effort distributions.
            </p>
          </div>
          <span class="text-xs font-semibold text-primary inline-flex items-center gap-1 mt-4">
            Open Dashboard →
          </span>
        </a>

        <a href={getBasePath("/ranking")} class="group rounded-2xl border border-border/80 bg-card/70 p-6 backdrop-blur hover:border-primary transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="size-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4 group-hover:scale-110 transition-transform">
              <Trophy class="size-5" />
            </div>
            <h3 class="font-bold text-base text-foreground mb-1 group-hover:text-primary transition-colors">Country Rankings</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Sortable, filterable table with full APPI index scores, individual food item pricing, and CSV/JSON downloads.
            </p>
          </div>
          <span class="text-xs font-semibold text-primary inline-flex items-center gap-1 mt-4">
            View Rankings →
          </span>
        </a>

        <a href={getBasePath("/compare")} class="group rounded-2xl border border-border/80 bg-card/70 p-6 backdrop-blur hover:border-primary transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="size-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-4 group-hover:scale-110 transition-transform">
              <BookOpen class="size-5" />
            </div>
            <h3 class="font-bold text-base text-foreground mb-1 group-hover:text-primary transition-colors">Side-by-Side Comparator</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Compare 2 to 4 countries head-to-head with radar charts and test your purchasing power with our relocation simulator.
            </p>
          </div>
          <span class="text-xs font-semibold text-primary inline-flex items-center gap-1 mt-4">
            Launch Comparator →
          </span>
        </a>
      </div>
    </div>
  </section>
</Layout>
