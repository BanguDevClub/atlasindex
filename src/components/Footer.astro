---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border/60 bg-card/40 backdrop-blur">
  <div class="container mx-auto px-4 py-12 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Mission -->
      <div class="md:col-span-2 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <div class="size-7 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
              <path d="M2 12h20"></path>
            </svg>
          </div>
          <span class="font-heading font-bold text-lg text-foreground">Atlas<span class="text-primary">Index</span></span>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed max-w-md">
          AtlasIndex is an independent open-data initiative comparing real purchasing power worldwide. By measuring median wage income against standardized nutritional food baskets, we reveal the actual hours of labor required to afford daily life.
        </p>
        <div class="flex items-center gap-3 pt-2 text-xs text-muted-foreground">
          <span class="flex items-center gap-1.5">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Data current: 2025 Release
          </span>
          <span>•</span>
          <span>Open Methodology & CC-BY 4.0</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="flex flex-col gap-2.5">
        <h4 class="font-semibold text-xs text-foreground uppercase tracking-wider">Explore AtlasIndex</h4>
        <ul class="flex flex-col gap-2 text-xs text-muted-foreground">
          <li><a href="/" class="hover:text-primary transition-colors">Overview & Highlights</a></li>
          <li><a href="/dashboard" class="hover:text-primary transition-colors">Global Dashboard</a></li>
          <li><a href="/ranking" class="hover:text-primary transition-colors">Country Ranking Table</a></li>
          <li><a href="/compare" class="hover:text-primary transition-colors">Side-by-Side Comparator</a></li>
          <li><a href="/methodology" class="hover:text-primary transition-colors">Methodology & Formulas</a></li>
        </ul>
      </div>

      <!-- Col 3: Data Sources -->
      <div class="flex flex-col gap-2.5">
        <h4 class="font-semibold text-xs text-foreground uppercase tracking-wider">Primary Sources</h4>
        <ul class="flex flex-col gap-2 text-xs text-muted-foreground">
          <li><a href="https://ilostat.ilo.org/" target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-between">ILOSTAT (ILO) <span class="text-[10px]">↗</span></a></li>
          <li><a href="https://www.oecd.org/employment/emp/onlineoecdemploymentdatabase.htm" target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-between">OECD Labour Force <span class="text-[10px]">↗</span></a></li>
          <li><a href="https://ec.europa.eu/eurostat" target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-between">Eurostat <span class="text-[10px]">↗</span></a></li>
          <li><a href="https://www.worldbank.org/en/programs/icp" target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-between">World Bank ICP <span class="text-[10px]">↗</span></a></li>
          <li><a href="https://www.fao.org/worldfoodsituation/foodpricesindex/en/" target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-between">FAO Food Price Index <span class="text-[10px]">↗</span></a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-border/40 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <p>© {year} AtlasIndex Project. Built with Astro & shadcn/ui. Designed with Catppuccin & Modern Web Standards.</p>
      <div class="flex items-center gap-4">
        <a href="/methodology#faq" class="hover:text-foreground transition-colors">FAQ</a>
        <a href="/methodology#limitations" class="hover:text-foreground transition-colors">Limitations</a>
        <a href="/ranking" class="hover:text-foreground transition-colors">Raw Datasets</a>
      </div>
    </div>
  </div>
</footer>
