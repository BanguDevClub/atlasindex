---
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "../ui/card";
import { Badge } from "../ui/badge";
import { Flame, UtensilsCrossed, Clock4, ShieldAlert, Sparkles, Scale } from "lucide-react";

const highlights = [
  {
    category: "The Beef & Meat Divide",
    icon: "🥩",
    title: "1 kg of Beef Requires 18 Mins in Norway vs 7.2 Hours in Egypt",
    description: "In high-wage European economies, high agricultural prices are readily absorbed by high median incomes. In emerging markets, animal protein consumes entire working days.",
    statA: { country: "Norway", flag: "🇳🇴", time: "18 mins labor", badge: "Low Burden" },
    statB: { country: "Brazil", flag: "🇧🇷", time: "2 hrs 10 mins", badge: "Moderate" },
    statC: { country: "Egypt", flag: "🇪🇬", time: "7 hrs 10 mins", badge: "Extreme" },
  },
  {
    category: "Carbohydrate Staple Security",
    icon: "🍚",
    title: "1 kg of Rice: 7 Minutes in USA vs 138 Minutes in Nigeria",
    description: "Basic grains form the caloric backbone of 60% of humanity. In developing economies, grain price volatility immediately threatens food security.",
    statA: { country: "USA", flag: "🇺🇸", time: "7 mins labor", badge: "Instant" },
    statB: { country: "India", flag: "🇮🇳", time: "24 mins labor", badge: "Accessible" },
    statC: { country: "Nigeria", flag: "🇳🇬", time: "2 hrs 18 mins", badge: "High Drain" },
  },
  {
    category: "Dairy & Eggs Access",
    icon: "🥚",
    title: "12 Fresh Eggs: 9 Minutes in Canada vs 1 Hour in South Africa",
    description: "Affording complete bioavailable proteins like eggs and dairy requires negligible labor in North America and Western Europe, but significant daily budget allocation elsewhere.",
    statA: { country: "Canada", flag: "🇨🇦", time: "9 mins labor", badge: "High Power" },
    statB: { country: "Spain", flag: "🇪🇸", time: "13 mins labor", badge: "High Power" },
    statC: { country: "South Africa", flag: "🇿🇦", time: "50 mins labor", badge: "Moderate" },
  },
];
---

<section class="py-12 border-t border-border/40">
  <div class="container mx-auto px-4 sm:px-8">
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        <Sparkles class="size-3.5" />
        <span>Granular Economic Contrasts</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
        The Global Labor Effort Divergence
      </h2>
      <p class="text-xs sm:text-sm text-muted-foreground mt-2">
        Absolute prices in supermarkets don't tell the story. The true economic divide is revealed when you calculate how many minutes of hard human labor purchase the same kilogram of nourishment.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {highlights.map((h) => (
        <div class="rounded-2xl border border-border/80 bg-card/60 p-6 backdrop-blur shadow-md flex flex-col justify-between hover:border-primary/50 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-2xl">{h.icon}</span>
              <span class="text-[11px] font-semibold text-primary uppercase tracking-wider">{h.category}</span>
            </div>
            <h3 class="text-base font-bold text-foreground leading-snug mb-2">{h.title}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-6">{h.description}</p>
          </div>

          <div class="space-y-2 border-t border-border/40 pt-4">
            <div class="flex items-center justify-between text-xs bg-background/60 rounded-lg p-2.5">
              <span class="font-medium">{h.statA.flag} {h.statA.country}</span>
              <span class="font-bold text-emerald-500">{h.statA.time}</span>
            </div>
            <div class="flex items-center justify-between text-xs bg-background/60 rounded-lg p-2.5">
              <span class="font-medium">{h.statB.flag} {h.statB.country}</span>
              <span class="font-bold text-amber-500">{h.statB.time}</span>
            </div>
            <div class="flex items-center justify-between text-xs bg-background/60 rounded-lg p-2.5">
              <span class="font-medium">{h.statC.flag} {h.statC.country}</span>
              <span class="font-bold text-rose-500">{h.statC.time}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
