---
import { ThemeToggle } from "./ThemeToggle";
import { getBasePath } from "../lib/utils";
import { Compass, BarChart2, Globe, Trophy, Scale, BookOpen, SlidersHorizontal } from "lucide-react";

const rawPathname = new URL(Astro.request.url).pathname;
const normalize = (p: string) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p);
const currentNormalized = normalize(rawPathname);

const navLinks = [
  { name: "Overview", href: getBasePath("/"), icon: Compass },
  { name: "Dashboard", href: getBasePath("/dashboard"), icon: BarChart2 },
  { name: "Continents", href: getBasePath("/continents"), icon: Globe },
  { name: "Global Ranking", href: getBasePath("/ranking"), icon: Trophy },
  { name: "Compare", href: getBasePath("/compare"), icon: Scale },
  { name: "Sandbox", href: getBasePath("/sandbox"), icon: SlidersHorizontal },
  { name: "Methodology", href: getBasePath("/methodology"), icon: BookOpen },
];
---

<header class="sticky top-0 z-40 w-full glass-nav backdrop-blur-xl border-b border-border/60 bg-background/80">
  <div class="container mx-auto flex h-16 items-center justify-between px-3 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href={getBasePath("/")} class="flex items-center gap-2.5 sm:gap-3 group">
      <div class="size-9 sm:size-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary group-hover:scale-105 group-hover:bg-primary/20 transition-all duration-300 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
          <path d="M2 12h20"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 sm:gap-2">
          <span class="font-heading font-extrabold text-base sm:text-lg tracking-tight text-foreground">Atlas<span class="text-primary">Index</span></span>
          <span class="rounded-full bg-primary/10 px-1.5 sm:px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-primary border border-primary/20">2025</span>
        </div>
        <span class="text-[10px] sm:text-[11px] text-muted-foreground hidden sm:inline">195 Sovereign Nations • 4 Living Pillars</span>
      </div>
    </a>

    <!-- Navigation links (Desktop) -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = currentNormalized === normalize(link.href);
        const IconComponent = link.icon;
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 ${
              isActive
                ? "bg-primary text-primary-foreground font-bold shadow-sm"
                : "text-muted-foreground hover:text-foreground hover:bg-accent/60"
            }`}
          >
            <IconComponent className="size-3.5" />
            <span>{link.name}</span>
          </a>
        );
      })}
    </nav>

    <!-- Theme and Actions -->
    <div class="flex items-center gap-1.5 sm:gap-3">
      <ThemeToggle client:load />

      <a
        href="https://github.com/BanguDevClub/atlasindex"
        target="_blank"
        rel="noreferrer"
        class="flex size-8 sm:size-9 items-center justify-center rounded-xl border border-input bg-card/60 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors shadow-sm"
        aria-label="GitHub Repository: BanguDevClub/atlasindex"
        title="View source on GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile navigation bar (Touch-optimized scrollable pill bar) -->
  <div class="flex lg:hidden overflow-x-auto border-t border-border/40 px-3 py-2 gap-1.5 scrollbar-none bg-muted/20">
    {navLinks.map((link) => {
      const isActive = currentNormalized === normalize(link.href);
      const IconComponent = link.icon;
      return (
        <a
          href={link.href}
          class={`whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all shrink-0 ${
            isActive
              ? "bg-primary text-primary-foreground font-bold shadow-sm"
              : "text-muted-foreground hover:text-foreground bg-background/60 border border-border/50"
          }`}
        >
          <IconComponent className="size-3.5" />
          <span>{link.name}</span>
        </a>
      );
    })}
  </div>
</header>
