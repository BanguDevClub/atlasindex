---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/globals.css";
import { getBasePath } from "../lib/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string;
}

const {
  title = "AtlasIndex — Global Economy, Median Wage & Food Purchasing Power",
  description = "Compare global economies by real purchasing power. Measure how many hours and minutes of labor a median wage earner needs to afford essential food baskets across all 195 countries of the world.",
  image,
  type = "website",
  keywords = "food purchasing power, purchasing power parity, median wage, global economy, cost of living index, nutrition index, real wage comparison, labor effort index, Big Mac index alternative, AtlasIndex, BanguDevClub",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://bangudevclub.github.io";
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, Astro.site || "https://bangudevclub.github.io");

const ogImageURL = image
  ? new URL(image, Astro.site || "https://bangudevclub.github.io").href
  : `${siteUrl}${getBasePath("/og-image.png")}`;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}${getBasePath("/#website")}`,
      "url": `${siteUrl}${getBasePath("/")}`,
      "name": "AtlasIndex",
      "description": "Global purchasing power and nutritional food labor effort index across all 195 countries.",
      "publisher": {
        "@type": "Organization",
        "name": "BanguDevClub",
        "url": "https://github.com/BanguDevClub"
      }
    },
    {
      "@type": "WebApplication",
      "@id": `${siteUrl}${getBasePath("/#webapp")}`,
      "url": `${siteUrl}${getBasePath("/")}`,
      "name": "AtlasIndex Economic Comparator & Food Labor Calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript",
      "creator": {
        "@type": "Organization",
        "name": "BanguDevClub",
        "url": "https://github.com/BanguDevClub"
      }
    },
    {
      "@type": "Dataset",
      "@id": `${siteUrl}${getBasePath("/#dataset")}`,
      "name": "AtlasIndex 2025 Global Food Purchasing Power & Median Wage Dataset",
      "description": "Cross-national dataset of median net wages, grocery prices for 13 standardized nutritional items, and labor minutes per food group across all 195 sovereign nations.",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "creator": {
        "@type": "Organization",
        "name": "BanguDevClub",
        "url": "https://github.com/BanguDevClub"
      },
      "temporalCoverage": "2024/2025",
      "spatialCoverage": "Global"
    }
  ]
};
---

<!doctype html>
<html lang="en" class="theme-mocha dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getBasePath("/favicon.svg")} />
    <link rel="manifest" href={getBasePath("/site.webmanifest")} />
    <meta name="theme-color" content="#89b4fa" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="BanguDevClub" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />
    <link rel="alternate" hreflang="en" href={canonicalURL.href} />

    <!-- Open Graph / Facebook / LinkedIn / Discord -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AtlasIndex — Global Economy & Food Purchasing Power Parity" />
    <meta property="og:site_name" content="AtlasIndex" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="AtlasIndex — Global Economy & Food Purchasing Power Parity" />
    <meta name="twitter:creator" content="@BanguDevClub" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-Flash Theme Script -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("atlasindex-theme") || "theme-mocha";
          var root = document.documentElement;
          root.classList.remove(
            "dark",
            "theme-latte",
            "theme-frappe",
            "theme-macchiato",
            "theme-mocha"
          );
          if (theme === "dark") {
            root.classList.add("dark");
          } else if (theme.startsWith("theme-")) {
            root.classList.add(theme);
            if (theme !== "theme-latte") {
              root.classList.add("dark");
            }
          }
        } catch (e) {
          console.error(e);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/20 selection:text-primary">
    <!-- Background subtle gradient decor -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-[30%] -left-[10%] w-[50vw] h-[50vw] rounded-full bg-primary/5 blur-[120px]"></div>
      <div class="absolute -bottom-[20%] -right-[10%] w-[40vw] h-[40vw] rounded-full bg-chart-4/5 blur-[120px]"></div>
    </div>

    <Navbar />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
